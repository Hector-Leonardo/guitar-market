  "api_get_user_shipments_request": {
    "description": "Request para obtener envíos del usuario",
    "endpoint": "GET /api/shipments/user/{userId}?status=shipped&limit=10",
    "query_params": {
      "status": "opcional - filtrar por estado: pending, processing, shipped, in_transit, delivered, cancelled",
      "limit": "opcional - máximo de resultados (default: 50)"
    }
  },

