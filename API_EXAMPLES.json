  "api_create_order_request": {
    "description": "Request al crear una orden desde frontend",
    "endpoint": "POST /api/create-order",
    "example": {
      "items": [
        {
          "id": 1,
          "name": "Guitarra Clásica",
          "description": "Guitarra de madera...",
          "price": 1000,
          "quantity": 1,
          "image": "guitarra1.jpg",
          "title": "Guitarra Clásica",
          "unit_price": 1000,
          "currency_id": "MXN"
        }
      ],
      "userId": "user-firebase-uid-12345",
      "shippingData": {
        "fullName": "Juan Pérez García",
        "phone": "5551234567",
        "street": "Av. Paseo de la Reforma 505",
        "apartment": "Piso 10, Depto 1005",
        "city": "Mexico City",
        "state": "CDMX",
        "postalCode": "06500",
        "shippingMethod": "express"
      },
      "total": 1150
    }
  },

