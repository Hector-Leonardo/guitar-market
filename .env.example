# =====================================================
# MERCADO PAGO
# =====================================================
# Obtener en: https://www.mercadopago.com/developers/panel/credentials
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxx

# ID del cliente de tu aplicación Mercado Pago
CLIENT_ID=1234567890

# Secret del cliente de tu aplicación Mercado Pago
CLIENT_SECRET=abcXYZ1234567890abcXYZ1234567890

# =====================================================
# FRONTEND (VITE)
# =====================================================
# URL del API backend
# En desarrollo: http://localhost:3000 (proxy) o puede ser local
# En producción con Railway: https://guitarmarket-backend.railway.app
VITE_API_URL=http://localhost:3000

# =====================================================
# SERVIDOR
# =====================================================
# Puerto en el que corre el servidor
PORT=3000

# URL base de la aplicación (para redirects y webhooks)
# En desarrollo local: http://localhost:3000
# En desarrollo remoto: https://xxx.ngrok.io
# En producción: https://tudominio.com
APP_URL=http://localhost:3000

# =====================================================
# FIREBASE (Opcional - para persistencia de órdenes)
# =====================================================
# ID del proyecto Firebase - Configura para guardar órdenes en Firestore
FIREBASE_PROJECT_ID=tu_project_id

# Nota: Las credenciales de Firebase Admin se cargan automáticamente desde:
# - Variables de entorno: GOOGLE_APPLICATION_CREDENTIALS
# - O desde la credencial de cuenta de servicio de Google Cloud

# =====================================================
# CLOUDINARY (Para almacenamiento de imágenes)
# =====================================================
# Obtener en: https://cloudinary.com/console/settings/credentials
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret


